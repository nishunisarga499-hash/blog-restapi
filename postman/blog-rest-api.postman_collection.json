                  "});",
                  "",
                  "pm.test(\"returns the created post with id and createdAt\", function () {",
                  "  const post = pm.response.json().data;",
                  "  pm.expect(post.id).to.be.a('string');",
                  "  pm.expect(post.title).to.eql('Understanding REST APIs');",
                  "  pm.expect(post.createdAt).to.be.a('string');",
                  "  pm.collectionVariables.set('postId', post.id);",
                  "});",
                  "",
                  "pm.test(\"has a Location header\", function () {",
                  "  pm.expect(pm.response.headers.get('Location')).to.include('/posts/');",
                  "});"
                ]
              }
            }
