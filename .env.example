# Copy this file to ".env" and adjust. NEVER commit the real .env file.

PORT=3000
NODE_ENV=development

# Storage driver: memory | file | mongo
#   memory - data lives in RAM only (lost on restart)
#   file   - data saved as JSON in ./data (default, no database needed)
#   mongo  - MongoDB via Mongoose (needs MONGODB_URI)
STORAGE_DRIVER=file
# DATA_DIR=./data
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/blog-api?retryWrites=true&w=majority

# JWT. Use a long random string, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# false -> anyone can create/update/delete posts (matches the basic assignment)
# true  -> POST/PUT/PATCH/DELETE on /posts require "Authorization: Bearer <token>"
AUTH_REQUIRED=false

# Comma-separated list of allowed browser origins, or * for any
CORS_ORIGIN=*

# Optional tuning
# BCRYPT_ROUNDS=10
# AUTH_RATE_LIMIT_MAX=100
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# LOG_REQUESTS=true
